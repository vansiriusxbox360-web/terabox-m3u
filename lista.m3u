ox.com/file/168f8221b7e49fdc955ea8b89c98ba01?fid=4398713428586-250528-104440630397868&rt=pr&sign=FDtAERK-DCb740ccc5511e5e8fedcff06b081203-ExxKaXBKB10gN24fJ14UkYmIgAI%3d&expires=8h&chkbd=0&chkv=0&dp-logid=425780113012233135&dp-callid=0&dstime=1785962825&r=550507604&vuk=4398713428586&origin=dlna"}]},{"name":"Dibus que no son ªnime/las que te ponian comiendo/merendando o desayunando si tenías cerca el cole/Y que no haya dibus puede/o algo de ªnime puedes hallar/hoven padawan/en la 2 con mucha marcha y ᐉTPH,  en la 3 Megatrix o el Club Disney en Tele5/cuando Tele5 molaba y ponyta Pokémon el sábado/No infantiles ni dibus, puro adultos/unuiverso chananut/La Hora Chanante","image":"https://m.media-amazon.com/images/M/MV5BODcxMmJmYTgtNGUyYi00Mzg4LWE4NmUtODgyZTNjYTY3M2U0XkEyXkFqcGc@._V1_SX300.jpg","info":"","stations":[{"name":"La Hora Chanante 01 Presentado por un Viejuno","url":"https://d.terabox.com/file/2bab04dffd013dbcea648085c8963e9a?fid=4398713428586-250528-418265103891561&rt=pr&sign=FDtAERK-DCb740ccc5511e5e8fedcff06b081203-rACn0cFa724n0Epnxd53gfDFoN0%3d&expires=8h&chkbd=0&chkv=0&dp-logid=425780113012233135&dp-callid=0&dstime=1785962825&r=431795462&vuk=4398713428586&origin=dlna"},{"name":"La Hora Chanante 02 Presentado por David Hasselhoff","url":"https://d.terabox.com/file/23bfebece7bb089df0a32faa1d1dc478?fid=4398713428586-250528-717463764292864&rt=pr&sign=FDtAERK-DCb740ccc5511e5e8fedcff06b081203-uXNpUrMzmaRgnZdF21DcxIjWqo4%3d&expires=8h&chkbd=0&chkv=0&dp-logid=425780113012233135&dp-callid=0&dstime=1785962825&r=870010512&vuk=4398713428586&origin=dlna"},{"name":"La Hora Chanante 03 Presentado por Nacho Duato","url":"https://d.terabox.com/file/7dca3a272b7872f54e5d07f47e4c2208?fid=4398713428586-250528-269293196801229&rt=pr&sign=FDtAERK-DCb740ccc5511e5e8fedcff06b081203-KHvPG6cHaJTxTicxT0Dx0btubAk%3d&expires=8h&chkbd=0&chkv=0&dp-logid=425780113012233135&dp-callid=0&dstime=1785962825&r=258030158&vuk=4398713428586&origin=dlna"},{"name":"La Hora Chanante 04 Presentado por Mi