-m3u/main/custom-posters/relatos_de_los_hermanos_grimm.jpg","info":"","stations":[{"name":"01 Los Músicos de Bremen","url":"https://d.terabox.com/file/7a198a4090f428a4b866fa14cc93ac41?fid=4398713428586-250528-664521953944745&rt=pr&sign=FDtAERK-DCb740ccc5511e5e8fedcff06b081203-deoWPQCGaZPt65ROSxs0FgW35uo%3d&expires=8h&chkbd=0&chkv=0&dp-logid=392717561207108575&dp-callid=0&dstime=1785839657&r=563092122&vuk=4398713428586&origin=dlna"},{"name":"02 Hansel y Gretel","url":"https://d.terabox.com/file/53944db3ef527fa0054606515c780900?fid=4398713428586-250528-596778202045932&rt=pr&sign=FDtAERK-DCb740ccc5511e5e8fedcff06b081203-pEMP9JAlpS5%2ftaiva8BfNv3cyeM%3d&expires=8h&chkbd=0&chkv=0&dp-logid=392717561207108575&dp-callid=0&dstime=1785839657&r=615623379&vuk=4398713428586&origin=dlna"},{"name":"03 La Princesa y El Sapo","url":"https://d.terabox.com/file/61187ee8c228b3110f9330205337185f?fid=4398713428586-250528-422739049533709&rt=pr&sign=FDtAERK-DCb740ccc5511e5e8fedcff06b081203-ytMo2Lg%2b%2fh%2fEEgQDc5kaZcDgKgw%3d&expires=8h&chkbd=0&chkv=0&dp-logid=392717561207108575&dp-callid=0&dstime=1785839657&r=467811798&vuk=4398713428586&origin=dlna"},{"name":"04 Caperucita Roja","url":"https://d.terabox.com/file/eb91336ccfb96de401d5d90d8646aeba?fid=4398713428586-250528-1110019580586752&rt=pr&sign=FDtAERK-DCb740ccc5511e5e8fedcff06b081203-KluH2fWpNVLFaU%2bDlKFGmWkQ7i0%3d&expires=8h&chkbd=0&chkv=0&dp-logid=392717561207108575&dp-callid=0&dstime=1785839657&r=232031656&vuk=4398713428586&origin=dlna"},{"name":"05 El Ganso De Oro","url":"https://d.terabox.com/file/cf9f5247ebb5d55bd22d79acdc8c7005?fid=4398713428586-250528-949275164742412&rt=pr&sign=FDtAERK-DCb740ccc5511e5e8fedcff06b081203-La04HR7MgM%2feRSJZi3lqT5KLwGg%3d&expires=8h&chkbd=0&chkv=0&dp-logid=392717561207108575&dp-callid=0&dstime=1785839657&r=345000918&vuk=4398713428586&origin=dlna"},{"name":"06 El Gato con Botas","url":"https://d.terabox.com/file/f0ad1cc7ce8d3e2ac9be01a03a50a11a?fid=4398713428586-250528-428499459086436&rt=pr&sign=FDt