us/no chorris/Sine Kinki","image":null,"info":"","stations":[{"name":"¿Qué he hecho yo para merecer esto (1984)","url":"https://d.terabox.com/file/f617dccfc193f44e61dbb24927db36a0?fid=4398713428586-250528-56313784116173&rt=pr&sign=FDtAERK-DCb740ccc5511e5e8fedcff06b081203-N%2fBRkNX4XsGbV6XstPOUTXRswGI%3d&expires=8h&chkbd=0&chkv=0&dp-logid=325031307337135404&dp-callid=0&dstime=1785587506&r=601197450&vuk=4398713428586&origin=dlna"},{"name":"7 Vírgenes (2005)","url":"https://d.terabox.com/file/645a59ece84ab5eccdfb3ccd6b705bff?fid=4398713428586-250528-779428542364322&rt=pr&sign=FDtAERK-DCb740ccc5511e5e8fedcff06b081203-UgVvrWTNZDzNsjuFkXwjid2aMT0%3d&expires=8h&chkbd=0&chkv=0&dp-logid=325031503768687227&dp-callid=0&dstime=1785587507&r=148114222&vuk=4398713428586&origin=dlna","image":"https://upload.wikimedia.org/wikipedia/en/e/e8/7_Virgins.jpg"},{"name":"Asalto al banco central (1983)","url":"https://d.terabox.com/file/7ddbdccb83788a846195ace3813d3c4f?fid=4398713428586-250528-373178793433324&rt=pr&sign=FDtAERK-DCb740ccc5511e5e8fedcff06b081203-AZwNo4oBzlihdZ6o3nqs1QCnhvM%3d&expires=8h&chkbd=0&chkv=0&dp-logid=325031503768687227&dp-callid=0&dstime=1785587507&r=822389967&vuk=4398713428586&origin=dlna"},{"name":"Barrio (1998)","url":"https://d.terabox.com/file/752f2f9daa8f63149766b4ef29536e32?fid=4398713428586-250528-489054050492026&rt=pr&sign=FDtAERK-DCb740ccc5511e5e8fedcff06b081203-EnCXSjsrPbGb0J9%2ftHlRLDzTm9c%3d&expires=8h&chkbd=0&chkv=0&dp-logid=325031503768687227&dp-callid=0&dstime=1785587507&r=556852949&vuk=4398713428586&origin=dlna","image":"https://m.media-amazon.com/images/M/MV5BMjQxZDdiYmQtNmFjMi00MTZlLTlhYTMtZDk1YjM3ZjM1Mzc5XkEyXkFqcGdeQXVyMTA0MjU0Ng@@._V1_SX300.jpg"},{"name":"Chicos Perversos (1983)","url":"https://d.terabox.com/file/bd01f3d6e3fec390ff0761d89d97649e?fid=4398713428586-250528-344265921909431&rt=pr&sign=FDtAERK-DCb740ccc5511e5e8fedcff06b081203-2w1N6bsUeXQjbRtuVnEr7s9Potg%3d&expires=8h&chkbd=0&chkv=0&dp-logid=325031503768687227&dp-callid=0&dstime=17855