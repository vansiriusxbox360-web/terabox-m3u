box-m3u/main/custom-posters/digimon_adventure.jpg","info":"","stations":[{"name":"Digimon Adventure 01","url":"https://d.terabox.com/file/2f63921a2ebb1df9d7fe27e06abcd2e8?fid=4398713428586-250528-466164075490755&rt=pr&sign=FDtAERK-DCb740ccc5511e5e8fedcff06b081203-bAzv8DkYWaF3cR9%2fE5XkKXZu574%3d&expires=8h&chkbd=0&chkv=0&dp-logid=407162554794551569&dp-callid=0&dstime=1785893469&r=938585624&vuk=4398713428586&origin=dlna"},{"name":"Digimon Adventure 02","url":"https://d.terabox.com/file/5c1665f220f4d1256f9d481395175074?fid=4398713428586-250528-76222614631918&rt=pr&sign=FDtAERK-DCb740ccc5511e5e8fedcff06b081203-qyViHgeuSSe6OX5l6X04YVQf1pQ%3d&expires=8h&chkbd=0&chkv=0&dp-logid=407162554794551569&dp-callid=0&dstime=1785893469&r=844643334&vuk=4398713428586&origin=dlna"},{"name":"Digimon Adventure 03","url":"https://d.terabox.com/file/0eae3ed0c532c23a75b7341de53e7010?fid=4398713428586-250528-1039979762383308&rt=pr&sign=FDtAERK-DCb740ccc5511e5e8fedcff06b081203-1G0JOWXgGu1ynAamhmuZJ7MjCBs%3d&expires=8h&chkbd=0&chkv=0&dp-logid=407162554794551569&dp-callid=0&dstime=1785893469&r=839988675&vuk=4398713428586&origin=dlna"},{"name":"Digimon Adventure 04","url":"https://d.terabox.com/file/cefc16de759d07cab493ba84a4cb9c98?fid=4398713428586-250528-638602936469866&rt=pr&sign=FDtAERK-DCb740ccc5511e5e8fedcff06b081203-Mr8rw2mDZaNRIVOkf7m18xXWOyQ%3d&expires=8h&chkbd=0&chkv=0&dp-logid=407162554794551569&dp-callid=0&dstime=1785893469&r=135868336&vuk=4398713428586&origin=dlna"},{"name":"Digimon Adventure 05","url":"https://d.terabox.com/file/2bfbb4ab505f8ee084a4208b2cd27ba3?fid=4398713428586-250528-806953627095256&rt=pr&sign=FDtAERK-DCb740ccc5511e5e8fedcff06b081203-xCo6I46XEJMe9%2boioICgXSRfwvs%3d&expires=8h&chkbd=0&chkv=0&dp-logid=407162554794551569&dp-callid=0&dstime=1785893469&r=843112869&vuk=4398713428586&origin=dlna"},{"name":"Digimon Adventure 06","url":"https://d.terabox.com/file/551c2385a804d3bfe8261ac78f3c0052?fid=4398713428586-250528-1112470453361494&rt=pr&sign=FDtAERK-DCb740ccc5511e