<?xml version="1.0" encoding="UTF-8"?>
<addon id="service.vansirius.tracker" name="VanSirius Tracker" version="1.0.0" provider-name="VanSirius">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
    <import addon="plugin.video.vansirius"/>
  </requires>
  <extension point="xbmc.service" library="service.py" start="startup"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="es">Seguimiento de reproduccion del addon (continuar viendo / vistos)</summary>
    <description lang="es">Registra el progreso de reproduccion de plugin.video.vansirius en watched.json para la seccion Continuar viendo.</description>
    <platform>all</platform>
    <assets>
      <icon>resources/icon.png</icon>
    </assets>
  </extension>
</addon>
